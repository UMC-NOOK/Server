aws_account_id = "123456789012"

# Network — prod gets its own VPC created by Terraform
vpc_cidr             = "10.1.0.0/16"
public_subnet_a_cidr = "10.1.1.0/24"

# Compute
ami_id           = "ami-xxxxxxxx"   # Ubuntu 22.04 LTS (ap-northeast-2)
instance_type    = "t3.small"
key_name         = null
create_eip       = true
root_volume_size = 20
admin_cidrs      = ["203.0.113.10/32"]
monitoring_cidrs = []               # set to monitoring private IP /32 after apply

# DNS (Route53) — disabled by default
# 1. Apply with enable_route53 = false first to get the server IP
# 2. Then set enable_route53 = true and create_route53_zone = true
# 3. Copy the dns_name_servers output to the domain registrar (NS records)
enable_route53      = false
create_route53_zone = true
route53_zone        = "booknook.work"
domain_subdomain    = "api"
