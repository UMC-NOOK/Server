{
  "annotations": {
    "list": []
  },
  "description": "Local and verification dashboard for k6 load-test runs. This dashboard is not for production incident monitoring.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 19,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "### Scope: `${run_id:text}` · `${test_name:text}` · `${api_name:text}`\nWorst/total for selected runs/time. Table keeps Run ID. Red/orange = investigate; blue/purple = neutral, not a verdict.",
        "mode": "markdown"
      },
      "title": "Run Summary",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Worst p95 and p99 per selected run in the current time range. These values are informational because each k6 run can use different thresholds.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "max(1000 * max_over_time(k6_http_req_duration_p95{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}[$__range]))",
          "instant": true,
          "legendFormat": "worst p95",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "max(1000 * max_over_time(k6_http_req_duration_p99{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}[$__range]))",
          "instant": true,
          "legendFormat": "worst p99",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "k6 Latency",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Worst failure rate and check success per selected run. Orange means at least one failure or an incomplete check; compare with the threshold recorded in the JSON report.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1E-9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "id": 21,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "max(max_over_time(k6_http_req_failed_rate{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}[$__range]))",
          "instant": true,
          "legendFormat": "worst failure",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "min(min_over_time(k6_checks_rate{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"}[$__range]))",
          "instant": true,
          "legendFormat": "worst checks",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "k6 Reliability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Completed and dropped iterations per selected run. Dropped iterations above zero indicate that the configured arrival rate was not fully delivered.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "id": 22,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "sum(max_over_time(k6_iterations_total{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"}[$__range]))",
          "instant": true,
          "legendFormat": "iterations",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "sum(max_over_time(k6_dropped_iterations_total{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"}[$__range])) or on() (0 * sum(max_over_time(k6_iterations_total{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"}[$__range])))",
          "instant": true,
          "legendFormat": "dropped",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "k6 Load Delivery",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Selected request names ranked by their worst p95 in the current time range. The table includes setup or smoke request names when API Name is All; narrow the variable to focus on a target API.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Run ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 28,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "p95 (ms)"
          }
        ]
      },
      "targets": [
        {
          "expr": "sort_desc(1000 * max_over_time(k6_http_req_duration_p95{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{run_id}} {{name}}",
          "range": false,
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Top API Offenders by p95",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "error_code": true,
              "expected_response": true,
              "group": true,
              "instance": true,
              "job": true,
              "method": true,
              "proto": true,
              "scenario": true,
              "url": true
            },
            "includeByName": {},
            "indexByName": {
              "run_id": 0,
              "test_name": 1,
              "name": 2,
              "status": 3,
              "Value": 4
            },
            "renameByName": {
              "run_id": "Run ID",
              "test_name": "Test",
              "name": "Request name",
              "status": "Status",
              "Value": "p95 (ms)"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 29,
      "panels": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ms"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 10,
            "w": 12,
            "x": 0,
            "y": 25
          },
          "id": 6,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "expr": "1000 * k6_http_req_duration_p95{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}",
              "legendFormat": "p95 {{name}}"
            },
            {
              "expr": "1000 * k6_http_req_duration_p99{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}",
              "legendFormat": "p99 {{name}}"
            }
          ],
          "title": "k6 API Latency by Name",
          "type": "timeseries",
          "description": "Client-observed k6 p95 and p99 per request name. Cold and warm requests remain separate through their request names and run IDs."
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 10,
            "w": 12,
            "x": 12,
            "y": 25
          },
          "id": 7,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "expr": "k6_http_req_failed_rate{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\",name=~\"${api_name:regex}\"}",
              "legendFormat": "failed {{name}}"
            },
            {
              "expr": "avg by (run_id, group) (k6_checks_rate{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"})",
              "legendFormat": "checks {{run_id}} {{group}}"
            }
          ],
          "title": "k6 Failure Rate and Checks",
          "type": "timeseries",
          "description": "k6 failure rate and checks per selected run. Consult the JSON report for the exact threshold used by that run."
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 35
          },
          "id": 8,
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "expr": "sum by (run_id, scenario) (k6_iterations_total{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"})",
              "legendFormat": "iterations {{run_id}} {{scenario}}"
            },
            {
              "expr": "sum by (run_id, scenario) (k6_dropped_iterations_total{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"})",
              "legendFormat": "dropped {{run_id}} {{scenario}}"
            }
          ],
          "title": "k6 Iterations and Dropped Iterations",
          "type": "timeseries",
          "description": "Completed and dropped iterations per run and scenario. Dropped iterations mean the configured arrival rate was not fully delivered."
        }
      ],
      "title": "k6 Request Results",
      "type": "row"
    }
  ],
  "preload": false,
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": [
    "nook",
    "loadtest",
    "local"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_req_duration_p95, run_id)",
        "includeAll": true,
        "label": "k6 Run ID",
        "multi": true,
        "name": "run_id",
        "query": {
          "query": "label_values(k6_http_req_duration_p95, run_id)",
          "refId": "PrometheusVariableQueryEditor-RunId"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_req_duration_p95{run_id=~\"${run_id:regex}\"}, test_name)",
        "includeAll": true,
        "label": "k6 Test Name",
        "multi": true,
        "name": "test_name",
        "query": {
          "query": "label_values(k6_http_req_duration_p95{run_id=~\"${run_id:regex}\"}, test_name)",
          "refId": "PrometheusVariableQueryEditor-TestName"
        },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_req_duration_p95{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"}, name)",
        "includeAll": true,
        "label": "API Name",
        "multi": true,
        "name": "api_name",
        "query": {
          "query": "label_values(k6_http_req_duration_p95{run_id=~\"${run_id:regex}\",test_name=~\"${test_name:regex}\"}, name)",
          "refId": "PrometheusVariableQueryEditor-ApiName"
        },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "NOOK Load Test",
  "uid": "nook-load-test",
  "version": 1
}
