          "expr": "max_over_time((sum(tomcat_threads_busy_threads{application=\"$application\",environment=~\"${environment:regex}\"}) / clamp_min(sum(tomcat_threads_config_max_threads{application=\"$application\",environment=~\"${environment:regex}\"}), 1))[$__range:])",
