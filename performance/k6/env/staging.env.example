# Copy this file to staging.env. Do not commit the copied file.
BASE_URL=https://staging-api.example.com
# The 9091 management port is plain HTTP unless it is explicitly proxied with TLS.
# If the management port is not externally exposed, point this to an internal/VPN URL.
MANAGEMENT_BASE_URL=http://staging-api.example.com:9091
RUN_PREFIX=staging
# This does not bypass the non-local target guard. Pass CONFIRM_PROD_LOADTEST=yes when running k6.
K6_REQUIRE_CONFIRM=no

# Current default: use a staging test user through dev login.
# Later OAuth/refresh-token based auth can reuse K6_REFRESH_TOKEN here.
K6_ACCESS_TOKEN=
K6_REFRESH_TOKEN=
K6_USER_EMAIL=k6-staging@test.com
K6_USER_NICKNAME=k6-staging

K6_SEARCH_KEYWORD=k6
K6_GLOBAL_SEARCH_KEYWORDS=자바,클린코드,해리포터
K6_GLOBAL_USER_POOL_SIZE=20
K6_GLOBAL_P95_THRESHOLD_MS=5000
K6_GLOBAL_FAILED_RATE_THRESHOLD=0.05
K6_ENABLE_EXTERNAL_API=
P95_THRESHOLD_MS=1000
FAILED_RATE_THRESHOLD=0.01
MAX_DROPPED_ITERATIONS=0
