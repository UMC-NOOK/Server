# Copy this file to local.env and adjust values if needed.
BASE_URL=http://host.docker.internal:8080
MANAGEMENT_BASE_URL=http://host.docker.internal:8080
RUN_PREFIX=local
K6_REQUIRE_CONFIRM=no

# Leave token fields empty to use the dev-login based test user flow.
K6_ACCESS_TOKEN=
K6_REFRESH_TOKEN=
K6_USER_EMAIL=
K6_USER_NICKNAME=

K6_SEARCH_KEYWORD=k6
K6_GLOBAL_SEARCH_KEYWORDS=자바,클린코드,해리포터
K6_GLOBAL_USER_POOL_SIZE=20
K6_GLOBAL_P95_THRESHOLD_MS=5000
K6_GLOBAL_FAILED_RATE_THRESHOLD=0.05
K6_ENABLE_EXTERNAL_API=
P95_THRESHOLD_MS=1000
FAILED_RATE_THRESHOLD=0.01
MAX_DROPPED_ITERATIONS=0

# Seed profile and namespace. light/normal/heavy map to fixed, reproducible sizes.
SEED_PROFILE=normal
SEED_NAMESPACE=
SEED_BOOK_TITLE_PREFIX=k6 seed book
SEED_RECORD_PREFIX=k6 seed record
