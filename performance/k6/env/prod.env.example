# Copy this file to prod.env. Do not commit the copied file.
BASE_URL=https://api.example.com
# The 9091 management port is plain HTTP unless it is explicitly proxied with TLS.
# If the management port is not externally exposed, point this to an internal/VPN URL.
MANAGEMENT_BASE_URL=http://management.example.internal:9091
RUN_PREFIX=prod
K6_REQUIRE_CONFIRM=yes
K6_PROD_BASE_URL_PATTERN=://api\.

# Prefer a restricted production test account and externally managed token.
K6_ACCESS_TOKEN=
K6_REFRESH_TOKEN=
K6_USER_EMAIL=
K6_USER_NICKNAME=

K6_SEARCH_KEYWORD=k6
K6_GLOBAL_SEARCH_KEYWORDS=자바,클린코드,해리포터
# A single production management token is restricted to a one-user pool.
# Multi-user pools require per-user credentials, which are not supported yet.
K6_GLOBAL_USER_POOL_SIZE=1
K6_GLOBAL_P95_THRESHOLD_MS=5000
K6_GLOBAL_FAILED_RATE_THRESHOLD=0.05
K6_ENABLE_EXTERNAL_API=
P95_THRESHOLD_MS=1000
FAILED_RATE_THRESHOLD=0.01
MAX_DROPPED_ITERATIONS=0

# Keep production seed intentionally small unless the team explicitly approves a larger run.
SEED_BOOKS=30
SEED_RECORDS_PER_BOOK=3
SEED_FOCUS_SESSIONS=10
SEED_BOOK_TITLE_PREFIX=k6 seed book
SEED_RECORD_PREFIX=k6 seed record
