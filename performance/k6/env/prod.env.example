# Copy this file to prod.env. Do not commit the copied file.
BASE_URL=https://api.example.com
# The 9091 management port is plain HTTP unless it is explicitly proxied with TLS.
# If the management port is not externally exposed, point this to an internal/VPN URL.
MANAGEMENT_BASE_URL=http://management.example.internal:9091
RUN_PREFIX=prod
K6_REQUIRE_CONFIRM=yes
K6_PROD_BASE_URL_PATTERN=://api\.

# Prefer a restricted production test account and externally managed token.
K6_ACCESS_TOKEN=
K6_REFRESH_TOKEN=
K6_USER_EMAIL=
K6_USER_NICKNAME=

P95_THRESHOLD_MS=1000
FAILED_RATE_THRESHOLD=0.01
